# Copy this file to .env.local and fill in your key.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Defaults to gemini-3.5-flash-lite if unset.
#
# Free-tier quota is per-model, per-day:
#   gemini-3.5-flash-lite  - fast, generous quota, slightly weaker on rare বানান
#   gemini-3.5-flash       - better accuracy, but only 20 requests/day free
# Note: gemini-2.5-flash is retired for new users and returns 404.
# GEMINI_MODEL=gemini-3.5-flash-lite
